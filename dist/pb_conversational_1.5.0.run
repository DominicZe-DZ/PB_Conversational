#!/bin/bash
# PB_Conversational (DominicZe) for Probe Basic - version 1.5.0
#   bash pb_conversational_1.5.0.run                              install (prompts if multiple configs exist)
#   bash pb_conversational_1.5.0.run install  INI_PATH            install into that configuration
#   bash pb_conversational_1.5.0.run install --set-aside-templates  move empty example USER tabs aside
#   bash pb_conversational_1.5.0.run uninstall [INI_PATH]         remove and restore configuration
#   bash pb_conversational_1.5.0.run status    [INI_PATH]         show installation status
#   bash pb_conversational_1.5.0.run --extract [FOLDER]           extract files only
set -e
command -v python3 >/dev/null || { echo "ERROR: python3 is required (included with Probe Basic)"; exit 1; }
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
sed -n '/^__PACKAGE__$/,$p' "$0" | tail -n +2 | base64 -d | tar -xz -C "$TMP"
if [ "$1" = "--extract" ] || [ "$1" = "--extraer" ]; then
    DEST="${2:-pb_conversational_1.5.0}"
    mkdir -p "$DEST" && cp -r "$TMP"/. "$DEST"/
    echo "Files extracted to $DEST"
    exit 0
fi
CMD="${1:-install}"
[ $# -gt 0 ] && shift
python3 "$TMP/installer/pb_conversational_installer.py" "$CMD" "$@"
exit $?
